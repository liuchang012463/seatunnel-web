# Docker Compose project name
COMPOSE_PROJECT_NAME=seatunnel-web

# Frontend Nginx image
SEATUNNEL_WEB_IMAGE=weifuwan/seatunnel-web:1.0.0

# Backend Spring Boot image
SEATUNNEL_WEB_API_IMAGE=weifuwan/seatunnel-web-api:1.0.0

# Browser access address:
# http://localhost:9001
SEATUNNEL_WEB_PORT=9001


# =========================
# MySQL
# =========================

MYSQL_ROOT_PASSWORD=seatunnel_root_password
MYSQL_DATABASE=seatunnel_web
MYSQL_USER=seatunnel
MYSQL_PASSWORD=seatunnel_password

# MySQL address used inside the Docker network.
# Do not change this to localhost.
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MySQL port exposed on the host.
# Use 3306 because the local 3306 port is already occupied.
MYSQL_HOST_PORT=3306


# =========================
# JVM
# =========================

JAVA_OPTS=-Xms512m -Xmx1024m

# Additional Spring Boot arguments
APP_OPTS=

# =========================
# Spring AI
# =========================

# Leave blank to disable job-log fault diagnosis.
SPRING_AI_API_KEY=
SPRING_AI_BASE_URL=
SPRING_AI_LLM_MODEL=


# =========================
# Security
# =========================

# Used to encrypt datasource passwords with AES-GCM.
# Generate a new value before production deployment.
SEATUNNEL_WEB_DATASOURCE_MASTER_KEY=replace_with_a_random_32_byte_secret_key

# =========================
# Built-in browser file upload / MinIO
# =========================

# The API writes browser uploads to this S3-compatible endpoint.
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ENDPOINT=http://127.0.0.1:9000
# The endpoint and credentials visible to the SeaTunnel Engine runtime.
# This endpoint must be reachable from the Engine container. In the bundled
# /mnt/lc/minio deployment, use http://82.157.22.233:19000.
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_ENDPOINT=http://82.157.22.233:19000
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_BUCKET=seatunnel-web-upload
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ACCESS_KEY=replace_with_minio_access_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_SECRET_KEY=replace_with_minio_secret_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_ACCESS_KEY=replace_with_minio_runtime_access_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_SECRET_KEY=replace_with_minio_runtime_secret_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ROOT_PREFIX=seatunnel-web-upload
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_SESSION_TTL_HOURS=24

# =========================
# Reusable file resource catalog (S3-compatible)
# =========================

# File resources use a separate logical root from legacy browser-upload
# sessions.  The provider contract is S3-compatible so it can later be
# backed by MinIO, Amazon S3, OSS, OBS, or another compatible service.
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_PROVIDER=S3_COMPATIBLE
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_ENDPOINT=http://127.0.0.1:9000
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_RUNTIME_ENDPOINT=http://82.157.22.233:19000
# Optional URL reachable by the user's browser; defaults to RUNTIME_ENDPOINT.
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_UPLOAD_ENDPOINT=
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_REGION=us-east-1
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_BUCKET=seatunnel-web-resource
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_ACCESS_KEY=replace_with_storage_access_key
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_SECRET_KEY=replace_with_storage_secret_key
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_RUNTIME_ACCESS_KEY=replace_with_runtime_access_key
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_RUNTIME_SECRET_KEY=replace_with_runtime_secret_key
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_ROOT_PREFIX=seatunnel-web-resource
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_CREDENTIAL_MODE=STATIC
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_PATH_STYLE_ACCESS=true
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_CONNECT_TIMEOUT_MS=10000
SEATUNNEL_WEB_FILE_RESOURCE_STORAGE_REQUEST_TIMEOUT_MS=30000

# =========================
# OpenMetadata 1.12.10
# =========================

# OM Server connection (enabled / base URL / token / timeouts) is configured only
# in 运行运维 → 探查引擎管理. Do not set METADATA_OPENMETADATA_ENABLED/BASE_URL/TOKEN
# for runtime — they are ignored.
METADATA_OPENMETADATA_EXTENSION_ENABLED=false
# Optional: the /omext route of open_metadata_extension, for example
# http://host.docker.internal:38000/omext when SeaTunnel Web runs in Docker,
# or http://127.0.0.1:38000/omext for a local JVM.
METADATA_OPENMETADATA_EXTENSION_BASE_URL=

# =========================
# Lake ODS warehouse
# =========================

# Configure the Doris ODS URL, account and local JDBC jar from the Web
# “数仓配置” page. No lake-specific environment variables are used.

# =========================
# Generic message push/pull (/api/v1/message/**)
# =========================

# These endpoints do not require an API key.
# Broker connection is configured here (or via application.yml defaults).

SEATUNNEL_MESSAGE_BROKER_HOST=127.0.0.1
SEATUNNEL_MESSAGE_BROKER_PORT=5672
SEATUNNEL_MESSAGE_BROKER_VHOST=/
SEATUNNEL_MESSAGE_BROKER_USERNAME=admin
SEATUNNEL_MESSAGE_BROKER_PASSWORD=rabbitmq123
SEATUNNEL_MESSAGE_BROKER_SSL_ENABLED=false
SEATUNNEL_MESSAGE_BROKER_CONNECTION_TIMEOUT_MS=10000

# File-resource upload notify (empty EXCHANGE = default exchange; routing key = queue name).
SEATUNNEL_MESSAGE_FILE_MQ_ENABLED=true
SEATUNNEL_MESSAGE_FILE_MQ_EXCHANGE=
SEATUNNEL_MESSAGE_FILE_MQ_ROUTING_KEY=order.sync

# Maximum accepted request payload size in bytes (default 1MB).
SEATUNNEL_MESSAGE_MAX_BODY_BYTES=1048576

# Hard ceiling on messages returned by one pull call, regardless of what the
# caller requests (default 100).
SEATUNNEL_MESSAGE_MAX_BATCH_SIZE=100

# Default pull deadline in milliseconds when the caller omits one (default 3000).
SEATUNNEL_MESSAGE_PULL_DEFAULT_TIMEOUT_MS=3000

# JSON parse limits. Payload structure is caller-defined, so these are capped
# below Jackson's defaults (maxNestingDepth default is 1000).
SEATUNNEL_MESSAGE_MAX_NESTING_DEPTH=200
SEATUNNEL_MESSAGE_MAX_STRING_LENGTH=1048576
SEATUNNEL_MESSAGE_MAX_NUMBER_LENGTH=1000
