# Frontend Nginx image
SEATUNNEL_WEB_IMAGE=seatunnel-web:local

# Backend image
SEATUNNEL_WEB_API_IMAGE=seatunnel-web-api:local

# Browser access port
SEATUNNEL_WEB_PORT=9001

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m

# Spring Boot additional arguments
APP_OPTS=

# =========================
# Spring AI
# =========================

# Leave blank to disable job-log fault diagnosis.
SPRING_AI_API_KEY=
SPRING_AI_BASE_URL=
SPRING_AI_LLM_MODEL=

# Master key used to AES-GCM encrypt datasource passwords. Replace before production use.
SEATUNNEL_WEB_DATASOURCE_MASTER_KEY=change_me

# =========================
# Built-in browser file upload / MinIO
# =========================

SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ENDPOINT=http://host.docker.internal:9000
# Must be reachable from the SeaTunnel Engine container.
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_ENDPOINT=http://82.157.22.233:19000
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_BUCKET=seatunnel-web-upload
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ACCESS_KEY=replace_with_minio_access_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_SECRET_KEY=replace_with_minio_secret_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_ACCESS_KEY=replace_with_minio_runtime_access_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_RUNTIME_SECRET_KEY=replace_with_minio_runtime_secret_key
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_ROOT_PREFIX=seatunnel-web-upload
SEATUNNEL_WEB_FILE_UPLOAD_MINIO_SESSION_TTL_HOURS=24

# =========================
# OpenMetadata 1.12.10
# =========================

METADATA_OPENMETADATA_ENABLED=false
METADATA_OPENMETADATA_BASE_URL=http://127.0.0.1:8585/api
METADATA_OPENMETADATA_TOKEN=
METADATA_OPENMETADATA_EXTENSION_ENABLED=false
# Docker-hosted extension example: http://host.docker.internal:38000/omext
METADATA_OPENMETADATA_EXTENSION_BASE_URL=
